# Copiar como .env para desarrollo local (docker-compose lo carga automáticamente).
APP_NAME=churn-api
APP_VERSION=1.0.0
MODEL_PATH=models/model.joblib
METADATA_PATH=models/metadata.json
PORT=8080
LOG_LEVEL=info
# Tope de clientes por peticion a /predict/batch. El plan de Cloud Run
# corre con 512Mi; este limite evita que un batch enorme agote la memoria.
MAX_BATCH_SIZE=500
